{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "nyla-sync",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-12",
  "durable_objects": {
    "bindings": [
      {
        "name": "VAULTS",
        "class_name": "Vault"
      }
    ]
  },
  "exports": {
    "Vault": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "invocation_logs": true
    }
  }
}
